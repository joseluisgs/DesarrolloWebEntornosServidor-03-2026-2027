@* ============================================================================
   _TarjetaProducto.cshtml - PARCIAL
   Una vista pequeña y reutilizable que recibe un producto y lo pinta como tarjeta.
   No tiene URL propia: solo se usa desde otras páginas, con <partial> o con
   Html.PartialAsync. Es la forma de no repetir el mismo trozo de HTML en 5 sitios.
   ============================================================================
*@
@model ProductDto
<article class="tarjeta">
    <img class="tarjeta__imagen" src="@Model.Imagen" alt="Foto de @Model.Nombre" />

    <div class="tarjeta__cuerpo">
        <p class="tarjeta__categoria">@Model.Categoria</p>

        <h3 class="tarjeta__titulo">
            @* Tag Helper de enlace a página: asp-route-id manda el valor por la ruta. *@
            <a asp-page="/Detalle" asp-route-id="@Model.Id">@Model.Nombre</a>
        </h3>

        <p class="tarjeta__descripcion">@Model.Descripcion</p>

        <div class="tarjeta__pie">
            @* Nuestro Tag Helper propio: convierte <precio> en un span con el importe formateado. *@
            <precio importe="@Model.Precio" destacado="@(Model.Precio >= 500)" />

            <span class="stock @(Model.Disponible ? "stock--ok" : "stock--agotado")">
                @(Model.Disponible ? $"Quedan {Model.Stock}" : "Agotado")
            </span>
        </div>
    </div>
</article>
