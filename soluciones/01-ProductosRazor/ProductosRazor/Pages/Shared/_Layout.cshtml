<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Productos Razor</title>
    @* Tag Helper de enlace: asp-append-version pone la versión del fichero en la URL,
       así el navegador no se queda con la caché del CSS cuando lo cambias. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="cabecera">
        <nav class="navegacion">
            <a class="navegacion__marca" asp-page="/Index">Productos Razor</a>

            <ul class="navegacion__lista">
                @* Tag Helper de enlace a página: asp-page resuelve la URL de la página
                   aunque cambies la ruta del fichero. *@
                <li><a asp-page="/Index">Catálogo</a></li>
                <li><a asp-page="/Directivas">Directivas</a></li>
                <li><a asp-page="/Estructuras">Estructuras</a></li>
                <li><a asp-page="/Funciones">Funciones</a></li>

                @* asp-route-categoria manda el valor como parámetro de la query string:
                   el resultado es /Categoria?categoria=Audio *@
                @foreach (var categoria in Enum.GetValues<ProductCategory>())
                {
                    <li><a asp-page="/Categoria" asp-route-categoria="@categoria">@categoria</a></li>
                }
            </ul>
        </nav>
    </header>

    <main class="contenido">
        @* RenderBody: aquí se inyecta el contenido de la página que se esté sirviendo. *@
        @RenderBody()
    </main>

    <footer class="pie">
        <p>J.L. González · Desarrollo Web en Entornos Servidor (DAW) · IES Luis Vives</p>
    </footer>

    @* RenderSectionAsync: la sección Scripts es opcional; cada página decide si la llena. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
