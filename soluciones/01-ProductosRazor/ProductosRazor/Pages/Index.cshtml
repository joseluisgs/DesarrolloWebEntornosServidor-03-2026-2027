@* ============================================================================
   Index.cshtml - el catálogo
   En esta página conviven cinco técnicas del tema, cada una marcada abajo:
   if, foreach, parcial, componente de vista (vc:) y Tag Helper propio (precio).
   ============================================================================
*@
@page
@model ProductosRazor.Pages.IndexModel
@{
    ViewData["Title"] = "Catálogo de productos";
}

<h1 class="titulo">Catálogo de productos</h1>

@* ViewData lleva los datos sueltos de la página. Se comprueba con @@if porque no se
   compara en tiempo de compilación: si te equivocas de nombre, el fallo es en runtime. *@
@if (ViewData["Mensaje"] is string mensaje)
{
    <p class="chiquito">@mensaje</p>
}

@* Técnica 1: COMPONENTE DE VISTA (vc:).
   <vc:catalog-summary /> busca CatalogSummaryViewComponent en el ensamblado
   y ejecuta su InvokeAsync(). Es lógica de servidor reutilizable, con su propia vista. *@
<vc:catalog-summary />

@* Técnica 2: ESTRUCTURA if / else. Todo lo que empieza por @@ entre llaves es C#. *@
@if (Model.Productos.Count == 0)
{
    <p class="vacio">El catálogo está vacío. Ejecuta la app en modo Development para que se siembre.</p>
}
else
{
    <div class="rejilla">
        @* Técnica 3: ESTRUCTURA foreach + Técnica 4: PARCIAL.
           En vez de pegar aquí el HTML de la tarjeta, se delega en _TarjetaProducto.cshtml. *@
        @foreach (var producto in Model.Productos)
        {
            <partial name="_TarjetaProducto" model="producto" />
        }
    </div>
}

@* Técnica 5: el Tag Helper propio <precio> vive dentro del parcial _TarjetaProducto. *@
