<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>ProductosWeb.RazorPages</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- CS1570 y CS1587: los comentarios XML de las vistas .cshtml no son XML bien formado -->
        <NoWarn>$(NoWarn);NU1902;NU1903;CS1591;CS1570;CS1587</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile>bin/$(Configuration)/$(TargetFramework)/ProductosWeb.RazorPages.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Todo el negocio está en el proyecto compartido: este solo aporta la visión Razor Pages -->
        <ProjectReference Include="..\ProductosWeb.Shared\ProductosWeb.Shared.csproj" />
    </ItemGroup>
</Project>
